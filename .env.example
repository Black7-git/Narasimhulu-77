# GEMINI_API_KEY: Required for Gemini AI API calls (grounded answers, resume extraction, form reasoning).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Local and production server listening port (default: 3000)
PORT="3000"

# BROWSER_WORKER_URL: Address of the external browser worker service (Playwright/Puppeteer streaming daemon)
# Required for live remote browser automation and remote Take Control streaming.
# If omitted or unreachable, ApplyPilot displays "Browser service not configured".
BROWSER_WORKER_URL=""

# BROWSER_WORKER_SECRET: Pre-shared bearer token for authenticating calls to the browser worker service.
BROWSER_WORKER_SECRET=""

# GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Client ID for Gmail OTP verification retrieval.
# Must be configured in Google Cloud Console with https://www.googleapis.com/auth/gmail.readonly.
GOOGLE_CLIENT_ID=""

# GOOGLE_CLIENT_SECRET: Optional Google OAuth 2.0 Client Secret for Gmail OTP token exchange.
GOOGLE_CLIENT_SECRET=""

# SESSION_SECRET: Secret key used to sign server session cookies and control leases.
SESSION_SECRET="change-this-to-a-secure-random-key"

# DATA_DIR: Filesystem directory for persistent local store and audit logs (default: ./data)
DATA_DIR="./data"
